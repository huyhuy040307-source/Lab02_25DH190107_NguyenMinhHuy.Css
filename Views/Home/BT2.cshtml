@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Forum Table</title>

    <style>
        table {
            width: 800px;
            border-collapse: collapse;
            font-family: Arial, sans-serif;
        }

        th {
            background-color: #eeeeee;
            padding: 10px;
            border-bottom: 1px solid #ccc;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        th, td {
            border-right: 1px solid #ccc;
        }

            th:first-child {
                text-align: left;
            }

            td:nth-child(2),
            td:nth-child(3) {
                text-align: center;
                font-weight: bold;
            }

        .topic {
            color: #2878b5;
            font-size: 18px;
        }

        .small {
            font-size: 12px;
            color: #333;
        }

        .last-post {
            color: #2878b5;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <table>
        <!-- Hàng tiêu đề -->
        <tr>
            <th>Topic</th>
            <th>Posts</th>
            <th>Views</th>
            <th>Last Post</th>
        </tr>

        <!-- Hàng 1 -->
        <tr>
            <td>
                <span class="topic">🔒 Posting Guidelines</span><br>
                <span class="small">
                    Posted in <b>Please Read First!</b> by Joe Gillespie
                </span>
            </td>

            <td>1</td>

            <td>288</td>

            <td>
                <span class="last-post">
                    Dec 21, 2003<br>
                    by Joe Gillespie
                </span>
            </td>
        </tr>

        <!-- Hàng 2 -->
        <tr>
            <td>
                <span class="topic">🔒 Forum Rules</span><br>
                <span class="small">
                    Posted in <b>Please Read First!</b> by Joe Gillespie
                </span>
            </td>

            <td>1</td>

            <td>2023</td>

            <td>
                <span class="last-post">
                    Dec 21, 2003<br>
                    by Joe Gillespie
                </span>
            </td>
        </tr>

        <!-- Hàng 3 -->
        <tr>
            <td>
                <span class="topic">💬 A suitable Word Template</span><br>
                <span class="small">
                    Posted in <b>Web Design Software</b> by Wilson Lang
                </span>
            </td>

            <td>2</td>

            <td>199</td>

            <td>
                <span class="last-post">
                    Mar 28, 2008<br>
                    by Shahzad Asif
                </span>
            </td>
        </tr>

        <!-- Hàng 4 -->
        <tr>
            <td>
                <span class="topic">💬 few HTML and CSS issues</span><br>
                <span class="small">
                    Posted in <b>Layout</b> by Jade M
                </span>
            </td>

            <td>3</td>

            <td>1</td>

            <td>
                <span class="last-post">
                    Mar 28, 2008<br>
                    by Shahzad Asif
                </span>
            </td>
        </tr>

    </table>

</body>
</html>
